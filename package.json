{
  "name": "truyennha",
  "version": "1.0.0",
  "description": "Nền tảng đọc truyện chữ tiếng Việt chất lượng cao chạy trên Cloudflare",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "d1:migrate:local": "wrangler d1 migrations apply DB --local",
    "d1:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "d1:seed:local": "wrangler d1 execute DB --local --file=./migrations/0002_demo_data.sql",
    "d1:seed:remote": "wrangler d1 execute DB --remote --file=./migrations/0002_demo_data.sql",
    "admin:bootstrap": "node ./scripts/bootstrap-admin.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "hono": "^4.7.2",
    "lucide-react": "^1.16.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.2",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250224.0",
    "@types/node": "^22.13.9",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vitest": "^3.0.7",
    "wrangler": "^3.111.0"
  }
}
